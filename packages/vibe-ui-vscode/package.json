{
  "name": "vibe-ui-vscode",
  "displayName": "Vibe UI Studio & Contrast Gate",
  "description": "Interactive Visual Chemistry Studio, live mathematical WCAG contrast auditor, and component inserter for Vibe UI",
  "version": "4.1.1",
  "publisher": "omid-io",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "vibe-ui",
    "oklch",
    "wcag",
    "accessibility",
    "cursor",
    "design-system",
    "tailwind"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:vibe-ui.chemistryExplorer",
    "onCommand:vibe-ui.auditContrast",
    "onCommand:vibe-ui.insertAdapter",
    "onCommand:vibe-ui.openShowcase"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibe-ui-sidebar",
          "title": "Vibe UI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vibe-ui-sidebar": [
        {
          "type": "webview",
          "id": "vibe-ui.chemistryExplorer",
          "name": "Visual Chemistries & Tokens"
        }
      ]
    },
    "commands": [
      {
        "command": "vibe-ui.auditContrast",
        "title": "Audit Component WCAG Contrast & Invariants",
        "category": "Vibe UI"
      },
      {
        "command": "vibe-ui.insertAdapter",
        "title": "Configure Workspace Adapter (Cursor / Claude Code / Windsurf)",
        "category": "Vibe UI"
      },
      {
        "command": "vibe-ui.openShowcase",
        "title": "Open Live Component Showcase",
        "category": "Vibe UI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vibe-ui.auditContrast",
          "when": "resourceExtname =~ /\\.(tsx|jsx|html|vue|svelte)$/",
          "group": "vibe-ui"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "author": "Omid Zaferi <https://github.com/omid-io>",
  "license": "MIT",
  "homepage": "https://omid-io.github.io/vibe-ui-suite/",
  "bugs": {
    "url": "https://github.com/omid-io/vibe-ui-suite/issues"
  },
  "qna": "https://github.com/omid-io/vibe-ui-suite/discussions",
  "repository": {
    "type": "git",
    "url": "https://github.com/omid-io/vibe-ui-suite.git",
    "directory": "packages/vibe-ui-vscode"
  }
}
