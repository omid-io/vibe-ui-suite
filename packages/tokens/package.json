{
  "name": "@omid-io/tokens",
  "version": "3.4.0",
  "description": "Typed OKLCH design tokens, physics curves, and zero-config Tailwind plugin for Vibe UI",
  "bin": {
    "vibe-ui": "./dist/cli.js",
    "tokens": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js"
    },
    "./v4": "./dist/v4.css",
    "./v4.css": "./dist/v4.css"
  },
  "scripts": {
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "design-tokens",
    "oklch",
    "tailwind",
    "vibe-ui",
    "ai-agents",
    "accessibility",
    "wcag"
  ],
  "author": "Omid Zaferi <https://github.com/omid-io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omid-io/vibe-ui-suite.git",
    "directory": "packages/tokens"
  }
}
