{
  "name": "vibe-ui-suite",
  "version": "6.4.2",
  "description": "Deterministic design contracts, 11 visual paradigms, flagship component recipes, and WCAG AA evaluation gates for AI coding agents.",
  "bin": {
    "vibe-ui-suite": "./dist/cli.js",
    "vibe-ui": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js"
    },
    "./v4": "./dist/v4.css",
    "./v4.css": "./dist/v4.css",
    "./registry": {
      "types": "./dist/registry/components.d.ts",
      "import": "./dist/registry/components.mjs",
      "require": "./dist/registry/components.js"
    },
    "./registry/*": {
      "types": "./dist/registry/*.d.ts",
      "import": "./dist/registry/*.mjs",
      "require": "./dist/registry/*.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "vibe-ui",
    "vibe-ui-suite",
    "vibe-coding",
    "design-tokens",
    "oklch",
    "tailwind",
    "tailwindcss",
    "ai-agents",
    "cursor",
    "cursorrules",
    "windsurf",
    "claude-code",
    "antigravity",
    "accessibility",
    "wcag",
    "anti-slop"
  ],
  "author": "Omid Zaferi <https://github.com/omid-io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omid-io/vibe-ui-suite.git",
    "directory": "packages/vibe-ui-suite"
  },
  "bugs": {
    "url": "https://github.com/omid-io/vibe-ui-suite/issues"
  },
  "homepage": "https://omid-io.github.io/vibe-ui-suite/"
}
