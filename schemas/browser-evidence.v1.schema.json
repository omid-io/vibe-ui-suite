{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-ui.io/schemas/browser-evidence.v1.schema.json",
  "title": "Harness Browser Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "runtime",
    "captured_at",
    "overall_status",
    "viewports",
    "checks",
    "visual_review"
  ],
  "properties": {
    "schema_version": {
      "const": "vibe.browser-evidence/v1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "browser",
        "browser_version",
        "platform"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "viewports": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height",
          "horizontal_overflow",
          "broken_images",
          "console_errors",
          "screenshot"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "horizontal_overflow": {
            "type": "boolean"
          },
          "broken_images": {
            "type": "integer",
            "minimum": 0
          },
          "console_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              },
              "attachment_id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "uri"
                ]
              },
              {
                "required": [
                  "attachment_id"
                ]
              }
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARN",
              "NOT_EVALUATED"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": [
              "string",
              "array",
              "object"
            ]
          }
        }
      }
    },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "summary",
        "inspected_screenshots",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "inspected_screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
